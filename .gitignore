__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Logs
logs/

# Backtest outputs (large, not needed for the app)
backtest results/

# One-time migration scripts
migrate_to_supabase.py

# Claude Code local config
.claude/

# Claude auto-memory (internal to Claude Code sessions)
memory/

# OS
.DS_Store
